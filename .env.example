# ────────────────────────────────────────────────────────
#  MAIH Photo Booth – Environment Variables
# ────────────────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser.

# ── Image Upload (optional) ──────────────────────────────
#
# Set this to enable the "Upload & Generate QR" feature.
# Without it, the app still works — users can download the
# poster as a PNG, but the QR code will not point to a live URL.
#
# Supported providers:
#
# 1. Imgur (anonymous upload, no account needed for basic use):
#    • Register an application at https://api.imgur.com/oauth2/addclient
#    • Set endpoint to: https://api.imgur.com/3/image
#    • Add header Authorization: Client-ID <YOUR_CLIENT_ID>
#    • The response JSON is:  { "data": { "link": "https://i.imgur.com/..." } }
#
# 2. Cloudflare R2 / AWS S3 (via a small serverless proxy):
#    • Deploy the included /functions/upload.js Cloudflare Pages Function
#    • Set VITE_UPLOAD_URL to your Pages subdomain + /api/upload
#
# 3. Custom backend:
#    • POST multipart/form-data with field name "image"
#    • Return JSON: { "url": "https://..." }
#
VITE_UPLOAD_URL=

# ── (Optional) pre-fill the event name ───────────────────
# VITE_EVENT_NAME=AI Innovation Summit 2025
